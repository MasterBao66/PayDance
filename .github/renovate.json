{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@tauri-apps/*", "tauri*"],
      "groupName": "Tauri packages",
      "groupSlug": "tauri"
    },
    {
      "matchPackageNames": [
        "vue",
        "vue-tsc",
        "@vitejs/plugin-vue",
        "@vue/test-utils",
        "eslint-plugin-vue",
        "eslint-plugin-vuejs-accessibility"
      ],
      "groupName": "Vue ecosystem",
      "groupSlug": "vue"
    },
    {
      "matchPackageNames": [
        "vite",
        "vitest",
        "happy-dom",
        "@tailwindcss/vite",
        "tailwindcss"
      ],
      "groupName": "Build & test tooling",
      "groupSlug": "build-tooling"
    },
    {
      "matchPackageNames": [
        "eslint",
        "prettier",
        "typescript-eslint",
        "@eslint/js",
        "eslint-config-prettier"
      ],
      "groupName": "Linting",
      "groupSlug": "linting"
    },
    {
      "matchPackageNames": ["typescript"],
      "groupName": "TypeScript",
      "groupSlug": "typescript",
      "allowedVersions": "<7",
      "description": "TypeScript 7 是原生移植版：vue-tsc 无法从中解析 tsc.js，typescript-eslint 直接拒绝启动。等两者宣布支持 TS 7 后再放开此上限。"
    },
    {
      "matchPackageNames": ["@types/node"],
      "groupName": "Node types",
      "groupSlug": "node-types",
      "allowedVersions": "<25",
      "description": "锁定在运行时主版本上：CI 与本地均使用 Node 24 LTS，类型版本超前会让编译期接受运行时不存在的 API。"
    },
    {
      "matchPackageNames": ["@lucide/vue"],
      "groupName": "Icons",
      "groupSlug": "icons"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde_json"],
      "groupName": "Rust serialization",
      "groupSlug": "rust-serde"
    }
  ],
  "timezone": "Asia/Shanghai"
}
